model ExerciseLog {
  id           Int        @id @default(autoincrement())
  workoutLogId Int
  actualSets   Int
  exerciseId   Int
  workoutLog   WorkoutLog @relation(fields: [workoutLogId], references: [id])
  exercise     Exercise   @relation(fields: [exerciseId], references: [id])
  setLogs      SetLog[]

  @@index([workoutLogId])
  @@index([exerciseId])
}

model SetLog {
  id            Int         @id @default(autoincrement())
  exerciseLogId Int
  setNumber     Int
  actualReps    Int
  weight        Float
  restTimeAfter Int?
  exerciseLog   ExerciseLog @relation(fields: [exerciseLogId], references: [id])

  @@index([exerciseLogId])
}

enum TrainingProgramStatus {
