  focus                     TrainingProgramFocus?    @relation(fields: [focusId], references: [id])
  trainingProgramTemplate   TrainingProgramTemplate? @relation(fields: [trainingProgramTemplateId], references: [id])
  level                     TrainingProgramLevel?    
  @@index([trainingProgramTemplateId])
  @@index([userId])
  @@index([focusId])
