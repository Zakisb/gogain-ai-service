model User {
  // Primary identifiers
  id          Int    @id @default(autoincrement())
  clerkUserId String @unique
  email       String @unique
  stripeCustomerId String? @unique
  // Basic profile info
  firstName   String?
  lastName    String?
  avatar      Int?
  avatarImage Image?  @relation(fields: [avatar], references: [id])

  // Organization related
  organizationId            Int?
  organization              Organization?  @relation(fields: [organizationId], references: [id])
  representativeFor         Organization[] @relation("Representative")
  // Status flags
  onboarded                 Boolean        @default(false)
  licenseId                 Int?
  appleHealthKitPromptShown Boolean        @default(false)
  googleFitPromptShown      Boolean        @default(false)

  // Timestamps
  createdAt DateTime @default(now())

  // AI related
  openaiThread Thread?

  // User data
  userRoles       UserRole[]
  userProfile     UserProfile?
  userPermissions UserPermission[]
  userAnswers     UserQuestionAnswer[]

  // Health & Fitness
  painAssessments    PainAssessment[]
  weightAssessments  WeightAssessment[]
  fitnessAssessments FitnessAssessment[]
  dailyHealthMetrics UserDailyHealthMetric[]
  activities         UserActivity[]

  // Training & Programs
  userPrograms    UserTrainingProgram[]
  createdPrograms TrainingProgramTemplate[] @relation("ProgramCreator")
  dietPlans       DietPlan[]

  // Coaching
  coachingSessions     CoachingSession[]            @relation("Coach")
  participatedSessions CoachingSessionParticipant[]

  // Club related
  clubs               ClubMember[]
  createdClubs        Club[]           @relation("ClubCreator")
  createdClubTeams    ClubTeam[]       @relation("ClubTeamCreator")
  clubTeamMemberships ClubTeamMember[]
  invitedMembers      ClubMember[]     @relation("Invitations")

  // Challenge related
  challengeNews          ChallengeNews[]
  createdChallenges      Challenge[]            @relation("ChallengeCreator")
  participatedChallenges ChallengeParticipant[]

  // Organization invites
  sentInvites   OrganizationInvite[] @relation("SentInvites")
  accountTypeId Int                  @default(1)
  accountType   UserAccountType      @relation(fields: [accountTypeId], references: [id])

  deleted           Boolean            @default(false)
  recipeBookmarks   RecipeBookmark[]
  exerciseBookmarks ExerciseBookmark[]

  jobTitleId              Int?
  jobTitle                JobTitle?                @relation(fields: [jobTitleId], references: [id])
  userHealthDataProviders UserHealthDataProvider[]
  sdkConnection           SDKConnection[]
  // Indexes

  subscriptions     Subscription[]
  subscriptionSeats SubscriptionSeat[]

  paymentMethods        PaymentMethod[]


  @@index([organizationId])
  @@index([clerkUserId])
  @@index([email])
  @@index([avatar])
  @@index([accountTypeId])
  @@index([jobTitleId])
}

model JobTitle {
