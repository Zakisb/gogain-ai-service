model UserTrainingDay {
  id                 Int                   @id @default(autoincrement())
  userProgramId      Int
  dayNumber          Int
  name               String
  date               DateTime
  status             TrainingStatus        @default(PLANNED)
  completedAt        DateTime?
  notes              String?
  durationInSeconds  Int?
